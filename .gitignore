# secrets & platform state
.rh_token
.rh_apikey
.rh_sandbox_wf
.rh_profile/

# python
__pycache__/
*.pyc
.venv/

# heavy data: re-collectable via collector/*.py
data/raw/
data/models/
downloads/
probe_out/

# experiment/composition OUTPUT images (configs & verdicts live in data/kb.db)
data/experiments/*/
data/composed/*/
data/explorations/**
# keep the assembled workflow definitions themselves
!data/composed/*.api.json

# scratch
_*.py
_tmp*
.qwen_key
.qwen_base
.qwen_model
.learnings/

# pre-migration db backups (never commit 3MB snapshots)
data/kb.db.bak-*
.venv-kb/

# DLC local clone (deployment route closed 2026-08-25)
local/

# video experiment raw outputs (heavy mp4s; metrics jsons + probe strips committed)
data/webtasks/h3_fl2v/**/*.mp4
# gallery view dirs = on-disk duplicates served by _static_gallery.py
data/swap/dlc_ab/
data/swap/dlc_ab_view/
data/swap/h3_fl2v_view/

data/webtasks/*/

data/swap/hairchain_A/*.png

