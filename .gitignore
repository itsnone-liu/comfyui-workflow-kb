# secrets & platform state
.rh_token
.rh_apikey
.rh_sandbox_wf
.rh_profile/

# python
__pycache__/
*.pyc
.venv/

# heavy data: re-collectable via collector/*.py
data/raw/
data/models/
downloads/
probe_out/

# experiment/composition OUTPUT images (configs & verdicts live in data/kb.db)
data/experiments/*/
data/composed/*/
# keep the assembled workflow definitions themselves
!data/composed/*.api.json

# scratch
_*.py
_tmp*
.qwen_key
.qwen_base
.qwen_model
.learnings/

# pre-migration db backups (never commit 3MB snapshots)
data/kb.db.bak-*
